generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model WebsiteSettings {
  id                Int      @id @default(1)
  schoolName        String   @default("St. Mary's Secondary School - Manja")
  shortName         String   @default("St. Mary's SS Manja")
  tagline           String   @default("Excellence & Virtue")
  motto             String   @default("We Learn by Doing")
  vision            String   @default("To be a Centre of Excellence all Round Achievers.")
  mission           String   @default("To produce practical, responsible citizens with high academic standards and moral values.")
  coreValues        String   @default("God-fearing, Discipline, Self-drive, High self-esteem.")
  introductionTitle String   @default("Welcome to St. Mary's Secondary School - Manja")
  introductionText  String   @default("St. Mary's Secondary School Manja is dedicated to nurturing holistic growth in both O-Level and A-Level secondary education.")
  heroTitle         String   @default("St. Mary's Secondary School")
  heroSubtitle      String   @default("Manja | Excellence & Virtue")
  centreCode        String   @default("ST MARYS MANJA")
  admissionsText    String   @default("Online Admissions")
  admissionsLink    String   @default("/admissions")
  whatsappNumber    String   @default("256700240640")
  phone             String   @default("")
  email             String   @default("")
  location          String   @default("Manja, Uganda")
  mapUrl            String   @default("https://maps.google.com/maps?q=Manja%20Secondary%20School%20Uganda&t=&z=13&ie=UTF8&iwloc=&output=embed")
  introductionImage String   @default("/Filed work.jpg")
  introductionMediaType String @default("image")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
    valuesEyebrow              String @default("Our Values")
  valuesDescription          String @default("The pillars that guide us in nurturing disciplined, responsible and successful citizens.")
  introductionButtonText     String @default("Discover Our School")
  introductionButtonLink     String @default("/about")
  academicLifeEyebrow        String @default("Learning in Action")
  academicLifeTitle          String @default("Academic and Student Life")
  academicLifeDescription    String @default("Our students learn through classroom teaching, field studies, educational tours, culture and community participation.")
  academicLifeButtonText     String @default("Explore Our Academics")
  academicLifeButtonLink     String @default("/academics")
  admissionsEyebrow          String @default("Admissions Open")
  admissionsHeading          String @default("Join St Mary's Secondary School-Manja")
  admissionsDescription      String @default("Begin your journey in a disciplined, supportive and academically focused school community.")
  admissionsPrimaryText      String @default("Apply Now")
  admissionsPrimaryLink      String @default("/admissions")
  admissionsSecondaryText    String @default("Contact the School")
  admissionsSecondaryLink    String @default("/contact")
}

model LeadershipMember {
  id           Int      @id @default(autoincrement())
  name         String
  role         String
  title        String?
  photo        String?
  theme        String?
  message      String
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HeroSlide {
  id           Int      @id @default(autoincrement())
  imageUrl     String
  mediaType    String   @default("image")
  altText      String?
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  title        String?
  subtitle     String?
  buttonText   String?
  buttonLink   String?
}

model GalleryItem {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  category     String   @default("General")
  mediaUrl     String
  mediaType    String   @default("image")
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdmissionApplication {
  id                Int      @id @default(autoincrement())
  applicationNumber String   @unique
  studentName       String
  gender            String
  dob               String?
  applyingClass     String
  parentName        String
  parentPhone       String
  parentEmail       String?
  previousSchool    String
  pleResults        String?
  status            String   @default("New")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ContactSettings {
  id               Int      @id @default(1)
  location         String
  phones           String
  emails           String
  weekdays         String
  saturday         String
  sunday           String
  visitText        String
  directionsText   String
  whatsappNumber   String
  mapUrl            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("New")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsArticle {
  id                Int       @id @default(autoincrement())
  title             String
  slug              String    @unique
  summary           String
  content           String
  category          String    @default("General")
  author            String    @default("School Administration")
  featuredMediaUrl  String?
  featuredMediaType String    @default("image")
  youtubeUrl        String?
  isPublished       Boolean   @default(false)
  isPinned          Boolean   @default(false)
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model MediaAsset {
  id         Int      @id @default(autoincrement())
  name       String
  storedName String   @unique
  url        String
  kind       String
  mimeType   String
  size       Int
  category   String   @default("General")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
model AcademicSettings {
  id                 Int      @id @default(1)
  heroTitle          String
  heroSubtitle       String
  heroMediaUrl       String
  heroMediaType      String   @default("image")
  oLevelTitle        String
  oLevelDescription  String
  oLevelItems        String
  aLevelTitle        String
  aLevelDescription  String
  aLevelSciences     String
  aLevelArts         String
  aLevelSubsidiaries String
  departmentsText    String
  subjectsText       String
  performanceText    String
  calendarText       String
  heroEyebrow              String @default("Learning for Life")
  oLevelButtonText         String @default("Learn More")
  oLevelButtonLink         String @default("#subjects")
  aLevelButtonText         String @default("Learn More")
  aLevelButtonLink         String @default("#subjects")
  academicLifeEyebrow      String @default("Learning in Action")
  academicLifeTitle        String @default("Academic Life")
  academicLifeDescription  String @default("A glimpse into the learning experiences and opportunities that shape our students every day.")
  departmentsTitle         String @default("Academic Departments")
  subjectsTitle            String @default("Subjects Offered")
  performanceTitle         String @default("Academic Performance")
  calendarTitle            String @default("School Calendar")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AcademicLifeItem {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  icon         String   @default("Book")
  mediaUrl     String
  mediaType    String   @default("image")
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
model AdmissionSettings {
  id                    Int      @id @default(1)
  heroTitle             String   @default("Online Application")
  heroSubtitle          String   @default("Apply to Join St Mary's Secondary School-Manja")
  vacanciesTitle        String   @default("Vacancies Open")
  vacanciesText         String   @default("We are currently accepting applications for the next intake.")

  step1Title            String   @default("1. Submit Application")
  step1Text             String   @default("Complete the online form below with accurate student and guardian details.")
  step2Title            String   @default("2. Assessment & Review")
  step2Text             String   @default("Our Admissions Office reviews submitted grades, results, and student history.")
  step3Title            String   @default("3. Admission & Reporting")
  step3Text             String   @default("Successful applicants receive official admission letters and guidelines for reporting.")

  formTitle             String   @default("Student Admission Application Form")
  formSubtitle          String   @default("Please fill in all required fields below to send your application directly to our admissions team.")
  submitButtonText      String   @default("Submit Application Form")

  successTitle          String   @default("Application submitted successfully!")
  successText           String   @default("Please keep this reference number. Our Admissions Office will contact you via phone or email.")

  documentsTitle        String   @default("Documents to Prepare & Bring During Admission")
  documentsItems        String   @default("Birth certificate (copy)\nMost recent end-of-term/PLE/UCE results\nTwo passport-size photos\nTestimonial from previous school\nFilled application form\nMedical form (provided after acceptance)")

  checklistTitle        String   @default("Requirements Checklist (PDF)")
  checklistDescription  String   @default("Download and print the required document list for physical submission.")
  checklistButtonText   String   @default("Coming soon")
  checklistUrl          String   @default("")

  classOptions          String   @default("Senior 1 (O-Level)\nSenior 2 (O-Level)\nSenior 3 (O-Level)\nSenior 4 (O-Level)\nSenior 5 (A-Level Arts/Sciences)\nSenior 6 (A-Level Arts/Sciences)")

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model GallerySettings {
  id              Int      @id @default(1)
  eyebrow         String   @default("School Life")
  title           String   @default("School Gallery")
  description     String   @default("Highlights of academic activities, sports events, educational trips and co-curricular life at St Mary's Secondary School-Manja.")
  emptyTitle      String   @default("Gallery Coming Soon")
  emptyText       String   @default("Photographs and videos will appear here after they are published from the Admin Portal.")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LeadershipSettings {
  id          Int      @id @default(1)
  eyebrow     String   @default("Meet Our Team")
  title       String   @default("School Leadership")
  description String   @default("Visionary leaders guiding academic excellence, discipline and holistic student development.")
  emptyText   String   @default("Leadership profiles will appear here after they are published from the Admin Portal.")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsSettings {
  id            Int      @id @default(1)
  eyebrow       String   @default("School Updates")
  title         String   @default("News & Announcements")
  description   String   @default("Follow the latest academic, sports, events and school community updates.")
  emptyTitle    String   @default("No published news yet")
  emptyText     String   @default("Published school updates will appear here.")
  pinnedLabel   String   @default("Pinned")
  readMoreText  String   @default("Read More")
  backText      String   @default("Back to News")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AboutSettings {
  id                     Int      @id @default(1)

  heroEyebrow            String   @default("About Our School")
  heroTitle              String   @default("St. Mary's Secondary School-Manja")
  heroDescription        String   @default("Learn more about our school, our purpose, values and commitment to student development.")

  welcomeEyebrow         String   @default("Welcome")
  mottoLabel             String   @default("Our Motto")
  missionLabel           String   @default("Our Mission")
  visionLabel            String   @default("Our Vision")

  valuesEyebrow          String   @default("What Guides Us")
  valuesTitle            String   @default("Our Core Values")
  valuesDescription      String   @default("The principles that guide our school community and the development of our learners.")

  governanceEyebrow      String   @default("School Governance")
  governanceTitle        String   @default("Board of Governors")
  governanceDescription  String   @default("Our school is guided by committed leaders who support good governance, accountability and educational excellence.")

  anthemEyebrow          String   @default("Our Identity")
  anthemTitle            String   @default("School Anthem")
  anthemText             String   @default("Our school anthem reflects our identity, values, unity and commitment to excellence.")

  ctaTitle               String   @default("Join Our School Community")
  ctaDescription         String   @default("Begin your application or contact the school office for more information.")
  ctaPrimaryText         String   @default("Apply Now")
  ctaPrimaryLink         String   @default("/admissions")
  ctaSecondaryText       String   @default("Contact Us")
  ctaSecondaryLink       String   @default("/contact")

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}
