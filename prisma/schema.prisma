generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model WebsiteSettings {
  id                Int      @id @default(1)
  schoolName        String   @default("St. Mary's Secondary School - Manja")
  shortName         String   @default("St. Mary's SS Manja")
  tagline           String   @default("Excellence & Virtue")
  motto             String   @default("We Learn by Doing")
  vision            String   @default("To be a Centre of Excellence all Round Achievers.")
  mission           String   @default("To produce practical, responsible citizens with high academic standards and moral values.")
  coreValues        String   @default("God-fearing, Discipline, Self-drive, High self-esteem.")
  introductionTitle String   @default("Welcome to St. Mary's Secondary School - Manja")
  introductionText  String   @default("St. Mary's Secondary School Manja is dedicated to nurturing holistic growth in both O-Level and A-Level secondary education.")
  heroTitle         String   @default("St. Mary's Secondary School")
  heroSubtitle      String   @default("Manja | Excellence & Virtue")
  centreCode        String   @default("ST MARYS MANJA")
  admissionsText    String   @default("Online Admissions")
  admissionsLink    String   @default("/admissions")
  whatsappNumber    String   @default("256700240640")
  phone             String   @default("")
  email             String   @default("")
  location          String   @default("Manja, Uganda")
  mapUrl            String   @default("https://maps.google.com/maps?q=Manja%20Secondary%20School%20Uganda&t=&z=13&ie=UTF8&iwloc=&output=embed")
  introductionImage String   @default("/Filed work.jpg")
  introductionMediaType String @default("image")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model LeadershipMember {
  id           Int      @id @default(autoincrement())
  name         String
  role         String
  title        String?
  photo        String?
  theme        String?
  message      String
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HeroSlide {
  id           Int      @id @default(autoincrement())
  imageUrl     String
  mediaType    String   @default("image")
  altText      String?
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  title        String?
  subtitle     String?
  buttonText   String?
  buttonLink   String?
}

model GalleryItem {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  category     String   @default("General")
  mediaUrl     String
  mediaType    String   @default("image")
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdmissionApplication {
  id                Int      @id @default(autoincrement())
  applicationNumber String   @unique
  studentName       String
  gender            String
  dob               String?
  applyingClass     String
  parentName        String
  parentPhone       String
  parentEmail       String?
  previousSchool    String
  pleResults        String?
  status            String   @default("New")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ContactSettings {
  id               Int      @id @default(1)
  location         String
  phones           String
  emails           String
  weekdays         String
  saturday         String
  sunday           String
  visitText        String
  directionsText   String
  whatsappNumber   String
  mapUrl            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("New")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsArticle {
  id                Int       @id @default(autoincrement())
  title             String
  slug              String    @unique
  summary           String
  content           String
  category          String    @default("General")
  author            String    @default("School Administration")
  featuredMediaUrl  String?
  featuredMediaType String    @default("image")
  youtubeUrl        String?
  isPublished       Boolean   @default(false)
  isPinned          Boolean   @default(false)
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model MediaAsset {
  id         Int      @id @default(autoincrement())
  name       String
  storedName String   @unique
  url        String
  kind       String
  mimeType   String
  size       Int
  category   String   @default("General")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
model AcademicSettings {
  id                 Int      @id @default(1)
  heroTitle          String
  heroSubtitle       String
  heroMediaUrl       String
  heroMediaType      String   @default("image")
  oLevelTitle        String
  oLevelDescription  String
  oLevelItems        String
  aLevelTitle        String
  aLevelDescription  String
  aLevelSciences     String
  aLevelArts         String
  aLevelSubsidiaries String
  departmentsText    String
  subjectsText       String
  performanceText    String
  calendarText       String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

